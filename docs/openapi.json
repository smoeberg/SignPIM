  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MappingIn": {
        "properties": {
          "source_value": {
            "type": "string",
            "title": "Source Value"
          },
          "normalized": {
            "type": "string",
            "title": "Normalized"
          },
          "field": {
            "type": "string",
            "title": "Field"
          }
        },
        "type": "object",
        "required": [
          "source_value",
          "normalized",
          "field"
        ],
        "title": "MappingIn"
      },
      "ProductIn": {
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "title": "Sku"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Price"
          },
          "ean": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ean"
          },
          "images": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Images"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency",
            "default": "DKK"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "sku",
          "name",
          "price"
        ],
        "title": "ProductIn"
      },
      "RuleIn": {
        "properties": {
          "rule_id": {
            "type": "string",
            "title": "Rule Id"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": "consistency"
          },
          "severity": {
            "type": "string",
            "title": "Severity",
            "default": "info"
          },
          "parameters": {
            "additionalProperties": true,
            "type": "object",
            "title": "Parameters",
            "default": {}
          },
          "global_rule": {
            "type": "boolean",
            "title": "Global Rule",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "rule_id"
        ],
        "title": "RuleIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}